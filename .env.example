# Root .env — used by workspace scripts (packages/db migrations, etc.)
# Copy to .env and fill in values, OR run `vercel env pull .env` to populate from Vercel.

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST_UNPOOLED/DBNAME?sslmode=require

PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=
