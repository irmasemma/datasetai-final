# apps/web/.env.local — Next.js loads this automatically for `pnpm dev`.
# Copy to .env.local and fill in values, OR run `vercel env pull apps/web/.env.local` to populate from Vercel.

# Neon Postgres (use the "dev" branch URL for local dev, NOT the main/production branch)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Public site URL — http://localhost:3006 for local dev
NEXT_PUBLIC_SITE_URL=http://localhost:3006
